# Jarvis Configuration File
# Optane storage path (relative directory since repo is on Optane drive on Windows)
OPTANE_STORAGE_PATH=./data/optane
VECTOR_DB_PATH=./data/optane/vector_db
BUFFER_PATH=./data/optane/buffer
MODELS_CACHE_PATH=./data/optane/models

# Target Latency & Hardware Settings
GPU_VRAM_BUDGET_GB=7.0
TARGET_LANGUAGE=pt-BR

# Audio & Voice Settings
STT_MODEL_NAME=whisper-large-v3-turbo
STT_COMPUTE_TYPE=int8
TTS_ENGINE=kokoro-onnx
TTS_VOICE=pt_BR_1

# Screen Capture Settings
CAPTURE_INTERVAL_SEC=2.0
CAPTURE_WIDTH=1280
CAPTURE_HEIGHT=720

# Router & Model Settings
LLM_MODEL_NAME=Qwen/Qwen2.5-VL-3B-Instruct
LLM_QUANTIZATION=4bit
RAG_TOP_K=3
